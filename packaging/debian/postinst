#!/bin/sh
set -e

USER=vidwatcher
GROUP=vidwatcher
STATE=/var/lib/vidwatcher

case "$1" in
    configure)
        if ! getent group "$GROUP" >/dev/null; then
            addgroup --system "$GROUP"
        fi
        if ! getent passwd "$USER" >/dev/null; then
            adduser --system --no-create-home --home "$STATE" \
                    --ingroup "$GROUP" --shell /usr/sbin/nologin "$USER"
        fi

        mkdir -p "$STATE"
        # -R so a stale root-owned state.json from a manual run gets fixed up.
        chown -R "$USER:$GROUP" "$STATE"
        chmod 0750 "$STATE"

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable vidwatcher.service || true
            if systemctl is-active --quiet vidwatcher.service; then
                systemctl try-restart vidwatcher.service || true
            else
                echo "vidwatcher: edit /etc/vidwatcher/config.toml (set 'watch'), then:"
                echo "  systemctl start vidwatcher"
            fi
        fi
        ;;
esac

exit 0
