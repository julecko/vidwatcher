[Unit]
Description=vidwatcher - batch AV1/Opus video converter
Documentation=file:/usr/share/doc/vidwatcher/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/vidwatcher --config /etc/vidwatcher/config.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Run unprivileged. Override with `systemctl edit vidwatcher` if you would
# rather it run as your own user (e.g. for media under /home).
User=vidwatcher
Group=vidwatcher

# /var/lib/vidwatcher, created and chowned by systemd.
StateDirectory=vidwatcher
StateDirectoryMode=0750

# Encoding is CPU/IO heavy, so run it at the very bottom of the priority order:
# use as much spare capacity as is going when the box is idle, but yield almost
# entirely the moment anything else wants the CPU or disk.
#
# SCHED_IDLE: only scheduled when no normal-priority task is runnable.
CPUSchedulingPolicy=idle
# Lowest cgroup weight, so even under cgroup contention it gets the crumbs.
CPUWeight=1
StartupCPUWeight=1
# Same idea for disk I/O.
IOSchedulingClass=idle
IOWeight=1

# No hard cap: it is free to use every idle core. If you would rather also put a
# ceiling on it, add one in a drop-in (`systemctl edit vidwatcher`):
#   [Service]
#   CPUQuota=400%          # never more than 4 cores, even when idle
#   AllowedCPUs=2-7        # or: keep it off cores 0-1 entirely

# Hardening. `ProtectHome` and `ProtectSystem` are deliberately loose because
# watched/output directories can be anywhere; tighten them in a drop-in if your
# media lives in a known location.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
